{
  "name": "marcelagotta",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && astro check --root signals",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og": "node scripts/og-image.ts",
    "deploy": "npm run build && wrangler deploy && npm run indexnow",
    "indexnow": "node scripts/indexnow.ts",
    "deploy:preview": "npm run build && wrangler versions upload --preview-alias preview",
    "deploy:redirect": "wrangler deploy -c workers/redirect/wrangler.jsonc",
    "preview:cf": "npm run build && wrangler dev",
    "signals:dev": "astro dev --root signals",
    "signals:build": "astro build --root signals",
    "signals:preview:cf": "npm run signals:build && wrangler dev -c signals/wrangler.jsonc",
    "signals:deploy:preview": "npm run signals:build && wrangler versions upload -c signals/wrangler.jsonc --preview-alias preview",
    "signals:deploy": "npm run signals:build && wrangler deploy -c signals/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents@2.3.3": true
  }
}
