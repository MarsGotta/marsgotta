# Headers for Cloudflare Workers static assets.

# HSTS leaves out includeSubDomains: other subdomains are served by third parties.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), display-capture=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

# Built files carry a content hash in their name, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800

# Other sites may show the share cards and the icons: link previews, newsletters, feed readers.
/og/*
  Cache-Control: public, max-age=604800
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/favicon.*
  Cache-Control: public, max-age=86400
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/logo.svg
  Cache-Control: public, max-age=86400

# Readers and agents decode it as Latin-1 unless told otherwise.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/grain-*
  Cache-Control: public, max-age=604800

# workers.dev serves copies of the site for testing, the version previews included: keep them out of search results.
https://:host.marcelagotta.workers.dev/*
  X-Robots-Tag: noindex
