---
import { portfolioUrl } from '../../lib/routes';
import type { Signal } from '../../data/signals';
import { getMessages } from '../../i18n';
import { newsletterReady } from '../../lib/newsletter';
import NewTabHint from '../layout/NewTabHint.astro';
import SubscribeForm from '../newsletter/SubscribeForm.astro';
import Avatar from './Avatar.astro';

interface Props {
  signal: Signal;
}

const { signal } = Astro.props;
const t = getMessages(signal.lang);
---

<footer class="col end">
  {signal.tags.length > 0 && (
    <ul class="tags">
      {signal.tags.map((tag) => (
        <li class="chip">{tag}</li>
      ))}
    </ul>
  )}
  <div class="author">
    <Avatar size="card" />
    <div>
      <p class="k">{t.post.byK}</p>
      <p class="n">Marcela Gotta</p>
      <p class="p">{t.post.byP}</p>
      <a class="ext" href={portfolioUrl(signal.lang)} target="_blank" rel="noopener noreferrer">
        marsgotta.com<span aria-hidden="true">↗</span>
        <NewTabHint lang={signal.lang} />
      </a>
    </div>
  </div>
  {newsletterReady && (
    <section class="next-nl" aria-labelledby="end-nl-title">
      <h2 id="end-nl-title">{t.post.endH}</h2>
      <p>{t.post.endP}</p>
      <SubscribeForm lang={signal.lang} source="post" titleId="end-nl-title" />
    </section>
  )}
</footer>

<style>
  .end {
    margin-top: 56px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--ink);
    font: 500 13.5px/1 var(--sans);
  }
  .author {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 20px;
    margin-top: 40px;
    padding-block: 32px;
    border-block: 1px solid var(--line);
  }
  .k {
    margin: 0;
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .n {
    margin: 8px 0 0;
    font: 600 22px/1.2 var(--serif);
    letter-spacing: -0.01em;
  }
  .p {
    margin: 8px 0 0;
    font: 400 16.5px/1.55 var(--serif);
    color: var(--ink-2);
  }
  .next-nl {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 40px;
    padding: 32px;
    border-radius: 16px;
    background: var(--bg-soft);
  }
  .next-nl::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: -90px;
    bottom: -140px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 30%, #e9603a, #8e2a2f 60%, #3a1420);
    opacity: 0.18;
  }
  .next-nl h2 {
    margin: 0;
    font: 600 26px/1.2 var(--serif);
    letter-spacing: -0.018em;
  }
  .next-nl > p {
    margin: 8px 0 20px;
    font: 400 16.5px/1.5 var(--serif);
    color: var(--muted);
  }
</style>
