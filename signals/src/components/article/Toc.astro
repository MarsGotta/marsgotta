---
import { getMessages, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  /** The ## of the signal, which are also its numbered sections. */
  headings: { slug: string; text: string }[];
}

const { lang, headings } = Astro.props;
const t = getMessages(lang);
---

<nav class="toc" aria-label={t.post.toc}>
  <p class="h" aria-hidden="true">
    {t.post.toc}
  </p>
  <ol>
    {headings.map((heading, index) => (
      <li>
        <a href={`#${heading.slug}`}>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          {heading.text}
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .toc {
    grid-column: 1;
    justify-self: end;
    width: 100%;
    max-width: 220px;
    position: sticky;
    top: 104px;
    align-self: start;
    padding-top: 6px;
  }
  .h {
    margin: 0 0 14px;
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 4px;
    padding: 7px 0 7px 14px;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 13.5px;
    line-height: 1.35;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  /* --muted rather than the prototype's --faint, which falls short of AA for text this small. */
  a span {
    font: 500 10px/1.7 var(--mono);
    color: var(--muted);
  }
  a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  @media (max-width: 1180px) {
    .toc {
      display: none;
    }
  }
</style>
