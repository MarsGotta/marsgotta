---
import { getMessages, type Lang } from '../../i18n';
import { lightTimeText } from '../../lib/sky';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
// Real values at build time, so nothing shifts; the script brings them to the visitor's minute.
const light = lightTimeText(Date.now(), lang);
---

<div class="strip">
  <div class="wrap in">
    <span class="k">{t.strip.k}</span>
    <div class="line" aria-hidden="true">
      <span>{t.strip.earth}</span>
      <i class="e"></i>
      <span class="track">
        <b></b>
      </span>
      <i class="m"></i>
      <span>{t.strip.mars}</span>
    </div>
    <span class="v" data-light-time>
      {t.strip.a} <b data-light-seconds>{light.time}</b> ·{' '}
      <span data-light-km>{light.distance}</span>
      {` ${t.strip.km}`}
    </span>
  </div>
</div>

<script>
  import { initLightTime } from '../../scripts/sky';

  initLightTime();
</script>

<style>
  .strip {
    border-block: 1px solid var(--line);
  }
  .in {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    min-height: 64px;
  }
  .k {
    font: 500 10.5px/1.3 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .line {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .e,
  .m {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .e {
    background: #5c8fd6;
    box-shadow: 0 0 8px rgba(92, 143, 214, 0.6);
  }
  .m {
    background: #e9603a;
    box-shadow: 0 0 8px rgba(233, 96, 58, 0.6);
  }
  .track {
    position: relative;
    flex: 1;
    height: 5px;
    overflow: hidden;
    background: repeating-linear-gradient(90deg, var(--line-2) 0 4px, transparent 4px 9px) center /
      100% 1px no-repeat;
  }
  /* The signal leaves Earth once and stays at Mars (4.6 s, under the 5 s of WCAG 2.2.2). Its own
     style is the arrival, so the animation fills backwards only. */
  .track b {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent calc(100% - 64px),
      var(--accent) calc(100% - 3px),
      transparent
    );
    animation: travel 4.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) 0.6s 1 backwards;
  }
  .v {
    font: 500 12px/1.3 var(--mono);
    letter-spacing: 0.06em;
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
    /* Tabular figures: the line keeps its width as the seconds change. */
    font-variant-numeric: tabular-nums;
  }
  .v b {
    font-weight: 600;
    color: var(--ink);
  }
  @keyframes travel {
    0% {
      transform: translateX(-100%);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }
  @media (max-width: 760px) {
    .in {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-block: 18px;
    }
    .v {
      text-align: left;
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track b {
      animation: none;
    }
  }
</style>
