---
import { getMessages, languages, type Lang } from '../../i18n';
import { switchPath, type Page } from '../../lib/routes';

interface Props {
  lang: Lang;
  page: Page;
  /** The slug of the signal's translation, when the page is a signal that has one. */
  translationSlug?: string | undefined;
}

const { lang, page, translationSlug } = Astro.props;
const t = getMessages(lang);
---

<div class="seg" role="group" aria-label={t.ui.lang}>
  {languages.map((code) => (
    <a
      href={code === lang ? undefined : switchPath(page, lang, translationSlug)}
      lang={code}
      hreflang={code}
      aria-current={code === lang ? 'true' : undefined}
    >
      {code.toUpperCase()}
    </a>
  ))}
</div>

<style>
  .seg {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .seg a {
    display: inline-grid;
    place-items: center;
    min-width: 36px;
    height: 30px;
    padding: 0 9px;
    border-radius: 999px;
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.1em;
    color: var(--muted);
    text-decoration: none;
  }
  .seg a[href]:hover {
    color: var(--ink);
  }
  .seg a[aria-current='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  @media (max-width: 480px) {
    .seg {
      display: none;
    }
  }
</style>
