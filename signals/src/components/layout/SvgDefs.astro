---
/* The Signals glyph (a source and its waves), referenced by id from the top bar and the footer.
   The Mars logo comes from the portfolio's own definitions. */
import PortfolioDefs from '@portfolio/components/layout/SvgDefs.astro';
---

<PortfolioDefs />
<svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="signals-glyph" viewBox="0 0 26 26">
      <circle cx="7.5" cy="18.5" r="4.3" fill="currentColor"></circle>
      <path
        d="M7.5 11.2a7.3 7.3 0 0 1 7.3 7.3"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
      ></path>
      <path
        d="M7.5 6.6a11.9 11.9 0 0 1 11.9 11.9"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        opacity=".65"
      ></path>
      <path
        d="M7.5 2a16.5 16.5 0 0 1 16.5 16.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        opacity=".35"
      ></path>
    </symbol>
  </defs>
</svg>

<style>
  .defs {
    position: absolute;
  }
</style>
