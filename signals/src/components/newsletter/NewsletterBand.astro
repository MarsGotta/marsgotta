---
import { getMessages, type Lang } from '../../i18n';
import { newsletterReady } from '../../lib/newsletter';
import { rssPath } from '../../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
// Without a provider the band invites to the RSS instead of promising an email (§6).
const copy = newsletterReady
  ? { a: t.nl.h2a, b: t.nl.h2b, sub: t.nl.sub }
  : { a: t.nlSoon.h2a, b: t.nlSoon.h2b, sub: t.nlSoon.sub };
---

<section class="band" id="suscribirse" aria-labelledby="band-title">
  <div class="stars" aria-hidden="true"></div>
  <div class="limb" aria-hidden="true"></div>
  <div class="wrap in">
    <div>
      <p class="over">
        <i class="live" aria-hidden="true"></i>
        {t.nl.over}
      </p>
      <h2 class="title" id="band-title">
        {copy.a} <em>{copy.b}</em>
      </h2>
    </div>
    <div>
      <p class="sub">{copy.sub}</p>
      {!newsletterReady && (
        <a class="ext" href={rssPath(lang)}>
          {t.nlSoon.rss}
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  /* Always night, in both themes, with the rim of Mars rising as in the portfolio's closing. */
  .band {
    --ink: #f5ece6;
    --ink-2: #e2d6ce;
    --muted: #b3a39a;
    --faint: #7d6e66;
    --line: rgba(245, 236, 230, 0.12);
    --line-2: rgba(245, 236, 230, 0.26);
    --surface: rgba(255, 255, 255, 0.06);
    --accent: #ff7f4a;
    --accent-hover: #ff9a6e;
    --accent-ink: #1a0d07;
    --ok: #9cda9b;
    --bad: #f6a19e;
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(88px, 10vw, 150px) clamp(140px, 15vw, 220px);
    background: #120b12;
    color: #f5ece6;
    color-scheme: dark;
  }
  .limb {
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: calc(-232vw + 110px);
    width: 250vw;
    height: 250vw;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 8%, #3c1420 0%, #24101e 30%, #160b16 60%);
    box-shadow:
      0 -1px 0 rgba(255, 127, 74, 0.7),
      0 -10px 40px rgba(233, 96, 58, 0.25),
      0 -60px 160px rgba(209, 23, 114, 0.14);
  }
  .stars {
    position: absolute;
    z-index: -2;
    inset: 0;
    opacity: 0.55;
    background-image:
      radial-gradient(1px 1px at 12% 22%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 28% 68%, #fff 50%, transparent 51%),
      radial-gradient(1.4px 1.4px at 44% 14%, #ffd9c6 50%, transparent 51%),
      radial-gradient(1px 1px at 63% 40%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 77% 18%, #fff 50%, transparent 51%),
      radial-gradient(1.4px 1.4px at 88% 58%, #d9ccff 50%, transparent 51%),
      radial-gradient(1px 1px at 6% 76%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 54% 82%, #fff 50%, transparent 51%);
  }
  .in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(36px, 6vw, 96px);
    align-items: end;
  }
  .title {
    margin: 22px 0 0;
    font: 500 clamp(44px, 6vw, 80px) / 0.98 var(--serif);
    letter-spacing: -0.04em;
    font-variation-settings: 'opsz' 72;
    text-wrap: balance;
  }
  .title em {
    font-style: italic;
    font-weight: 400;
    color: #ff9a6e;
  }
  .sub {
    margin: 0 0 26px;
    font: 400 19px/1.55 var(--serif);
    color: var(--ink-2);
    max-width: 28em;
  }
  @media (max-width: 900px) {
    .in {
      grid-template-columns: 1fr;
    }
  }
</style>
