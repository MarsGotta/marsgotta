---
import { COVER_VIEWBOX, generateCover, type CoverKind, type Topic } from '../../lib/covers';

interface Props {
  kind: CoverKind;
  topic: Topic;
  number: number;
  /** Where it shows, which sets its proportions (design/signals/LEEME.md §4). */
  shape: 'feature' | 'row' | 'card' | 'article';
}

const { kind, topic, number, shape } = Astro.props;
// Drawn at build time from the signal's number: no image to make and no script in the browser.
const cover = generateCover(kind, topic, number);
---

<div class:list={['cover', shape]}>
  <svg viewBox={COVER_VIEWBOX} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="1200" height="750" fill={cover.background}></rect>
    {cover.shapes.map((shape) => (
      <path
        d={shape.d}
        fill={shape.fill}
        stroke={shape.stroke}
        stroke-width={shape.strokeWidth}
        opacity={shape.opacity}
      />
    ))}
  </svg>
</div>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    background: #1c1418;
  }
  .cover svg {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }
  /* Covers inside a link zoom in a little when the link is hovered. */
  :global(a:hover) > .cover svg,
  :global(a:hover) .cover svg {
    transform: scale(1.03);
  }
  .feature {
    aspect-ratio: 16 / 10;
    border-radius: 6px;
  }
  .row {
    aspect-ratio: 3 / 2;
    border-radius: 4px;
  }
  .card {
    aspect-ratio: 16 / 9;
    border-radius: 6px;
  }
  .article {
    aspect-ratio: 16 / 8;
    border-radius: 6px;
  }
  @media (max-width: 560px) {
    .row {
      aspect-ratio: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover svg {
      transition: none;
    }
    :global(a:hover) .cover svg {
      transform: none;
    }
  }
</style>
