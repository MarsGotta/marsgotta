---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import Footer from '../components/layout/Footer.astro';
import SvgDefs from '../components/layout/SvgDefs.astro';
import SeoHead from '../components/layout/SeoHead.astro';
import TopBar from '../components/layout/TopBar.astro';
import NewsletterBand from '../components/newsletter/NewsletterBand.astro';
import type { Signal } from '../data/signals';
import { getMessages, type Lang } from '../i18n';
import type { Page } from '../lib/routes';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Null for the 404, which is not a page of the site map. */
  page: Page | null;
  /** The slug of a signal's translation, for the language switch. */
  translationSlug?: string | undefined;
  /** For pages that only make sense in a flow, such as the subscription's confirmation. */
  noindex?: boolean;
  /** On an article, for its Open Graph card and its structured data. */
  signal?: Signal | undefined;
}

const { lang, title, description, page, translationSlug, noindex = false, signal } = Astro.props;
const t = getMessages(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SeoHead
      lang={lang}
      title={title}
      description={description}
      page={page}
      translationSlug={translationSlug}
      noindex={noindex}
      signal={signal}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Only the body text's file is preloaded: italic and latin-ext load when a page uses them. */}
    <link
      rel="preload"
      href="/fonts/newsreader-latin-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Applies the theme before the first paint, so the page never flashes: the visitor's choice
      // if there is one, and otherwise the system's. Light («papel») is the default.
      let saved = null;
      try {
        saved = localStorage.getItem('theme');
      } catch {
        // Storage blocked: follow the system.
      }
      const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      if (dark) document.documentElement.dataset.theme = 'dark';
    </script>
  </head>
  <body>
    <SvgDefs />
    <a class="skip" href="#main">
      {t.ui.skip}
    </a>
    <TopBar lang={lang} page={page} translationSlug={translationSlug} />
    <main id="main">
      <slot />
      <NewsletterBand lang={lang} />
    </main>
    <Footer lang={lang} />
  </body>
</html>
