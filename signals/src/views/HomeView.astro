---
import FeedSection from '../components/feed/FeedSection.astro';
import EmptyState from '../components/home/EmptyState.astro';
import LightTimeStrip from '../components/home/LightTimeStrip.astro';
import Masthead from '../components/home/Masthead.astro';
import { getSignalsIn } from '../data/signals';
import { getMessages, type Lang } from '../i18n';
import Base from '../layouts/Base.astro';
import { featuredSignal } from '../lib/featured';
import { homeFeed } from '../lib/feed';
import { archivePath, homePath } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
const signals = await getSignalsIn(lang);
const featured = featuredSignal(signals, lang);
---

<Base lang={lang} title="Signals by Mars" description={t.home.sub} page={{ kind: 'home' }}>
  <Masthead lang={lang} featured={featured} />
  <LightTimeStrip lang={lang} />
  {featured ? (
    <FeedSection
      lang={lang}
      listed={homeFeed(signals, lang)}
      all={signals}
      allLink={{ href: homePath(lang), current: true }}
      archiveHref={archivePath(lang)}
    />
  ) : (
    <EmptyState lang={lang} />
  )}
</Base>
