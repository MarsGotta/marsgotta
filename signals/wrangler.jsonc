{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "signals",
  "main": "workers/index.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The pages run code to pick the visitor's language (workers/language.ts), and /api/subscribe
    // starts a signup. Signals live at the root, so everything runs it except the build's files.
    "run_worker_first": ["/*", "!/_astro/*", "!/fonts/*", "!/favicon.svg"],
  },
  // Five signups a minute per visitor IP, as the portfolio's contact form: plenty for a person.
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "routes": [{ "pattern": "signals.marsgotta.com", "custom_domain": true }],
  // wrangler turns workers.dev off when routes exist, so it is turned back on here: the smoke tests
  // and the version URLs to review live there, and _headers keeps them out of search engines.
  "workers_dev": true,
  "preview_urls": true,
}
