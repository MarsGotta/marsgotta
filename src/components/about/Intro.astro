---
import { getMessages, type Lang } from '../../i18n';
import QuickFacts from './QuickFacts.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang).about;
---

<section class="sec sec--tight" aria-label={t.kicker}>
  <div class="wrap intro">
    <div class="intro__text">
      <p class="lede">{t.p1}</p>
      <p>{t.p2}</p>
      <p>{t.p3}</p>
      <p>{t.p4}</p>
    </div>
    <QuickFacts lang={lang} />
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 48px;
  }
  .intro__text {
    grid-column: 1 / 8;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  /* Paragraphs keep their default 1em margins, which add to the gap as in the prototype. */
  .intro__text p {
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.66;
  }
  .intro__text .lede {
    font-size: clamp(20px, 1.8vw, 25px);
    line-height: 1.5;
    color: var(--fg);
  }
  @media (max-width: 980px) {
    .intro__text {
      grid-column: 1 / -1;
    }
  }
</style>
