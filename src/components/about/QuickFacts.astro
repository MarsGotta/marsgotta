---
import { getMessages, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const t = getMessages(Astro.props.lang).about;
---

<aside class="spec" aria-labelledby="facts-title">
  <h2 class="label" id="facts-title">
    {t.factsT}
  </h2>
  <dl>
    {t.facts.map((fact) => (
      <div>
        <dt>{fact.k}</dt>
        <dd>{fact.v}</dd>
      </div>
    ))}
  </dl>
</aside>

<style>
  .spec {
    grid-column: 9 / 13;
    align-self: start;
    position: sticky;
    top: 100px;
  }
  dl {
    margin: 18px 0 0;
    border-top: 1px solid var(--line);
  }
  dl div {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font: 500 10.5px/1.3 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--fg);
  }
  @media (max-width: 980px) {
    .spec {
      grid-column: 1 / -1;
      position: static;
    }
  }
</style>
