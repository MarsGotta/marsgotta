---
import { getMessages, type Lang } from '../../i18n';
import { contactEndpoint, contactLimits, contactOutcomes, honeypotField } from '../../lib/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang).contact;
---

<div class="box" data-contact>
  <form class="card form" action={contactEndpoint} method="post" aria-label={t.formLabel}>
    <input type="hidden" name="lang" value={lang} />
    <p class="required">{t.required}</p>
    <div class="field">
      <label for="contact-name">{t.name}</label>
      <input
        class="input"
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        maxlength={contactLimits.name}
        required
      />
    </div>
    <div class="field">
      <label for="contact-email">{t.email}</label>
      <input
        class="input"
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength={contactLimits.email}
        required
      />
    </div>
    <div class="field">
      <label for="contact-message">{t.msg}</label>
      <textarea
        class="input"
        id="contact-message"
        name="message"
        rows="6"
        maxlength={contactLimits.message}
        required
      ></textarea>
    </div>
    <div hidden>
      <input type="text" name={honeypotField} tabindex="-1" autocomplete="off" />
    </div>
    <p class="outcome error" id={contactOutcomes.error} tabindex="-1" data-outcome="error">
      {t.error}
    </p>
    <div class="actions">
      <button type="submit" class="btn btn--primary">
        {t.send}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 12h15M13 6l6 6-6 6"></path>
        </svg>
      </button>
    </div>
  </form>
  <div
    class="card outcome sent"
    id={contactOutcomes.sent}
    role="status"
    tabindex="-1"
    data-outcome="sent"
  >
    <svg viewBox="0 0 260 120" aria-hidden="true">
      <path class="arc" d="M 20 100 Q 130 -20 240 70"></path>
      <circle cx="20" cy="100" r="3" fill="currentColor" opacity=".5"></circle>
      <circle class="planet" cx="240" cy="70" r="14"></circle>
      <circle class="packet" r="4"></circle>
    </svg>
    <h3>{t.sent}</h3>
  </div>
</div>

<script>
  import { initContactForms } from '../../scripts/contact-form';

  initContactForms();
</script>

<style>
  .card {
    position: relative;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: 26px;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .form {
    display: grid;
    gap: 18px;
  }
  .field {
    display: grid;
    gap: 9px;
  }
  .required {
    margin: 0;
    font: 500 10.5px/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  label {
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .input {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    /* The border is what shows where to type: it keeps 3:1 against the card (WCAG 1.4.11). */
    border: 1px solid var(--fg-subtle);
    border-radius: 13px;
    background: transparent;
    color: var(--fg);
    font: 400 16px/1.4 var(--sans);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .input::placeholder {
    color: var(--fg-subtle);
  }
  .input:hover {
    border-color: var(--fg-muted);
  }
  /* The field keeps a visible focus ring: a warm border plus a soft glow. */
  .input:focus {
    outline: none;
    border-color: var(--warm);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--warm) 28%, transparent);
  }
  textarea.input {
    height: auto;
    min-height: 160px;
    padding: 15px 16px;
    resize: vertical;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
  }

  /* The outcome shows when the script sets data-state, or, without JavaScript, when the Worker's
     redirect lands on its fragment (:target). */
  .outcome {
    display: none;
  }
  .error:target,
  .box[data-state='error'] .error {
    display: block;
  }
  .box:has(.sent:target) .form,
  .box[data-state='sent'] .form {
    display: none;
  }
  .sent:target,
  .box[data-state='sent'] .sent {
    display: grid;
  }

  .error {
    margin: 0;
    color: var(--fg);
  }
  .sent {
    place-items: center;
    gap: 22px;
    min-height: 440px;
    text-align: center;
  }
  .sent svg {
    width: 260px;
    height: 120px;
    overflow: visible;
  }
  .arc {
    fill: none;
    stroke: var(--line-strong);
    stroke-dasharray: 3 5;
  }
  .planet {
    fill: url(#planet-gradient);
  }
  .packet {
    fill: var(--warm);
    offset-path: path('M 20 100 Q 130 -20 240 70');
    animation: send 1.6s cubic-bezier(0.5, 0, 0.3, 1) both;
  }
  .sent h3 {
    margin: 0;
    font: 700 clamp(28px, 3vw, 40px) / 1.1 var(--display);
    letter-spacing: -0.03em;
    animation: rise 0.6s ease 1.4s both;
  }
  @keyframes send {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  /* The static version is the end of the flight: the message has arrived. */
  @media (prefers-reduced-motion: reduce) {
    .packet {
      display: none;
    }
    .sent h3 {
      animation: none;
    }
  }
</style>
