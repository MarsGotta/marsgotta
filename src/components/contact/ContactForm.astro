---
import { email } from '../../content/profile';
import { getMessages, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const t = getMessages(Astro.props.lang).contact;
---

<form
  class="form"
  action={`mailto:${email}`}
  method="post"
  enctype="text/plain"
  aria-label={t.formLabel}
>
  <div class="field">
    <label for="contact-name">{t.name}</label>
    <input class="input" id="contact-name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="contact-email">{t.email}</label>
    <input
      class="input"
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      required
    />
  </div>
  <div class="field">
    <label for="contact-message">{t.msg}</label>
    <textarea class="input" id="contact-message" name="message" rows="6" required></textarea>
  </div>
  <div class="actions">
    <button type="submit" class="btn btn--primary">
      {t.send}
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 12h15M13 6l6 6-6 6"></path>
      </svg>
    </button>
  </div>
</form>

<style>
  .form {
    position: relative;
    display: grid;
    gap: 18px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: 26px;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .field {
    display: grid;
    gap: 9px;
  }
  label {
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .input {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 13px;
    background: transparent;
    color: var(--fg);
    font: 400 16px/1.4 var(--sans);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .input::placeholder {
    color: var(--fg-subtle);
  }
  .input:hover {
    border-color: var(--fg-subtle);
  }
  /* The field keeps a visible focus ring: a warm border plus a soft glow. */
  .input:focus {
    outline: none;
    border-color: var(--warm);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--warm) 28%, transparent);
  }
  textarea.input {
    height: auto;
    min-height: 160px;
    padding: 15px 16px;
    resize: vertical;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
  }
</style>
