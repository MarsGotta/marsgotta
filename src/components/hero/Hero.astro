---
import { getMessages, type Lang } from '../../i18n';
import { localizedPath } from '../../i18n/routes';
import Headline from './Headline.astro';
import Legend from './Legend.astro';
import PlanetSystem from './PlanetSystem.astro';
import SpaceBackdrop from './SpaceBackdrop.astro';
import SurfaceScene from './SurfaceScene.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
// The over-line is the same English phrase on both pages: screen readers need its language.
const overLang = t.hero.over === getMessages('en').hero.over ? 'en' : undefined;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <SpaceBackdrop />
  <SurfaceScene />
  <div class="wrap hero__in">
    <p class="label hero__over">
      <i aria-hidden="true"></i>
      <span lang={overLang}>{t.hero.over}</span>
    </p>
    <Headline lang={lang} id="hero-title" />
    <p class="lead hero__sub">{t.hero.sub}</p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href={localizedPath('projects', lang)}>
        {t.hero.cta1}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 12h15M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a class="btn btn--ghost" href={localizedPath('contact', lang)}>
        {t.hero.cta2}
      </a>
    </div>
  </div>
  <PlanetSystem lang={lang} />
  <Legend lang={lang} />
  <a class="next" href="#sistema">
    <svg
      class="loop"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M8 2v11M3.5 8.5 8 13l4.5-4.5"></path>
    </svg>
    <span>{t.home.next}</span>
    <b>(01) {t.sys.kicker}</b>
  </a>
</section>

<script>
  import { initParallax } from '../../scripts/parallax';

  initParallax();
</script>

<style>
  .hero {
    /* How far the headline and the planet (PlanetSystem) sit above the prototype's position. The
       hero keeps its height: the space moves from above the headline to below the buttons. */
    --hero-lift: clamp(40px, 3.8vw, 56px);
    position: relative;
    isolation: isolate;
    min-height: 960px;
    margin-top: calc(-1 * var(--nav-height));
    padding-top: var(--nav-height);
    overflow: clip;
  }
  .hero__in {
    position: relative;
    z-index: 5;
    padding-top: calc(clamp(64px, 6.6vw, 100px) - var(--hero-lift));
    padding-bottom: calc(150px + var(--hero-lift));
  }
  .hero__over {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 30px;
  }
  .hero__over i {
    display: block;
    width: 30px;
    height: 1px;
    background: var(--warm);
  }
  .hero__sub {
    max-width: 33em;
    margin-top: 38px;
    font-size: clamp(18px, 1.4vw, 20px);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .hero__over,
  .hero__sub,
  .hero__ctas {
    animation: rise 0.9s var(--ease-out) backwards;
  }
  .hero__over {
    animation-delay: 0.15s;
  }
  .hero__sub {
    animation-delay: 1.25s;
  }
  .hero__ctas {
    animation-delay: 1.45s;
  }
  /* «Next stop», on the legend's baseline and aligned with the content. */
  .next {
    position: absolute;
    z-index: 6;
    left: calc(max(0px, (100% - 1344px) / 2) + var(--gutter));
    bottom: 44px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--fg-muted);
    text-decoration: none;
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* It shows up once the headline is in. */
    animation: fade 1s ease 2.2s backwards;
    transition: color 0.25s;
  }
  .next b {
    font-weight: 500;
    color: var(--fg);
  }
  .next:hover {
    color: var(--fg);
  }
  .next svg {
    width: 16px;
    height: 16px;
    animation: bob 2.4s ease-in-out infinite;
  }
  @media (max-width: 980px) {
    .hero {
      min-height: 0;
    }
    .next {
      display: none;
    }
    :root[data-theme='light'] .hero {
      padding-bottom: 230px;
    }
    .hero__in {
      padding-top: 28px;
      padding-bottom: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__over,
    .hero__sub,
    .hero__ctas,
    .next {
      animation: none;
    }
  }
</style>
