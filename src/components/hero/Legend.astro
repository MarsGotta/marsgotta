---
import { getMessages, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const t = getMessages(Astro.props.lang);
---

<div class="legend when-dark" aria-hidden="true">
  <span>
    <i></i>
    {t.hero.phobos}
  </span>
  <b>T 7 h 39 min</b>
  <span class="legend__a">a {t.hero.aPh}</span>
  <span>
    <i class="de"></i>
    {t.hero.deimos}
  </span>
  <b>T 30 h 18 min</b>
  <span class="legend__a">a {t.hero.aDe}</span>
  <span>{t.hero.mars}</span>
  <b>{t.hero.rot}</b>
  <span class="legend__a">{t.hero.scale}</span>
</div>
<div class="legend legend--surface when-light" aria-hidden="true">
  <span>{t.hero.view}</span>
  <b>{t.hero.viewDir}</b>
  <span>{t.hero.phobos}</span>
  <b>{t.hero.phRise}</b>
  <span>{t.hero.deimos}</span>
  <b>{t.hero.deRise}</b>
</div>

<style>
  .legend {
    position: absolute;
    z-index: 6;
    right: var(--gutter);
    bottom: 44px;
    display: grid;
    grid-template-columns: auto auto auto;
    gap: 7px 18px;
    align-items: center;
    font: 500 10px/1.3 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* Small text over the nebula: muted, not subtle, keeps 4.5:1. */
    color: var(--fg-muted);
    animation: fade 1s ease 2s both;
  }
  .legend i {
    display: inline-block;
    width: 18px;
    height: 1px;
    margin-right: 8px;
    vertical-align: middle;
    background: var(--orbit-a);
  }
  .legend i.de {
    background: var(--orbit-b);
  }
  .legend b {
    font-weight: 500;
    color: var(--fg);
  }
  .legend--surface {
    grid-template-columns: auto auto;
    bottom: 62px;
    color: var(--fg);
  }
  .legend--surface b {
    color: var(--fg);
    font-weight: 600;
  }
  @media (max-width: 980px) {
    .legend {
      position: relative;
      right: auto;
      bottom: auto;
      margin: 0 var(--gutter) 40px;
      grid-template-columns: auto auto;
    }
    /* In the light theme there is no planet between the buttons and the legend. */
    .legend--surface {
      margin-top: 40px;
    }
    .legend__a {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .legend {
      animation: none;
    }
  }
</style>
