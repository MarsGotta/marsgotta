---
import { getMessages, otherLang, type Lang } from '../../i18n';
import type { RouteKey } from '../../i18n/routes';
import { alternates, ogImage, ogLocale, pageUrl, structuredData } from '../../lib/seo';

interface Props {
  lang: Lang;
  /** Null for pages outside the site map, such as the 404: they are not indexed. */
  route: RouteKey | null;
  title: string;
  description: string;
}

const { lang, route, title, description } = Astro.props;
const site = Astro.site ?? new URL('https://marsgotta.com');
const t = getMessages(lang);
const image = ogImage(site, lang);
const imageAlt = [...t.hero.l1, ...t.hero.l2, ...t.hero.l3].join(' ');
const schema = structuredData(site, { route, lang, title, description });
---

<meta name="description" content={description} />
{route ? (
  <>
    <link rel="canonical" href={pageUrl(site, route, lang)} />
    {alternates(site, route).map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <meta property="og:url" content={pageUrl(site, route, lang)} />
  </>
) : (
  <meta name="robots" content="noindex" />
)}
{/* About is her profile; the rest are pages of her site. */}
{route === 'about' ? (
  <>
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Marcela" />
    <meta property="profile:last_name" content="Gotta" />
  </>
) : (
  <meta property="og:type" content="website" />
)}
<meta property="og:site_name" content="Marcela Gotta" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ogLocale(lang)} />
<meta property="og:locale:alternate" content={ogLocale(otherLang(lang))} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@marcelagotta" />
<meta name="twitter:creator" content="@marcelagotta" />
{/* Escaping < keeps any text in the data from closing the script element. */}
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
