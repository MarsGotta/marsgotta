---
import { getMessages, type Lang } from '../../i18n';
import { manifestoTokens } from '../../lib/manifesto';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
const tokens = manifestoTokens(t.home.manifesto.text);
---

<section class="sec manifesto" id="por-que" aria-labelledby="why-title">
  <div class="wrap">
    {/* The heading says it for screen readers; the numbered label would only repeat it. */}
    <p class="label rule" aria-hidden="true">
      <span class="num">(01)</span>
      {t.home.manifesto.kicker}
    </p>
    <h2 class="sr-only" id="why-title">
      {t.home.manifesto.kicker}
    </h2>
    <p class="text">
      {tokens.map((token) =>
        token.kind === 'word' ? (
          <span class="w">{token.text}</span>
        ) : (
          <span class="w">
            <a
              class:list={['pill', `p-${token.key}`]}
              href="#sistema"
              data-pick-project={token.key}
            >
              <i aria-hidden="true" />
              {t.sys.items[token.key].name}
            </a>{' '}
          </span>
        ),
      )}
    </p>
    <p class="sign">
      <svg viewBox="0 0 560 560" aria-hidden="true">
        <use href="#brand-mark" width="560" height="560"></use>
      </svg>
      <span>{t.home.manifesto.sign}</span>
    </p>
  </div>
</section>

<script>
  import { initManifestoPills } from '../../scripts/manifesto';

  initManifestoPills();
</script>

<style>
  .manifesto {
    padding-block: clamp(110px, 12vw, 200px) clamp(72px, 8vw, 128px);
  }
  .text {
    max-width: 22.5em;
    margin: clamp(40px, 4.4vw, 72px) 0 0;
    font: 600 clamp(30px, 4.35vw, 66px) / 1.12 var(--display);
    letter-spacing: -0.034em;
    color: var(--fg);
    text-wrap: pretty;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.26em;
    margin-right: 0.22em;
    padding: 0.06em 0.42em 0.1em 0.3em;
    border: 1px solid color-mix(in srgb, var(--pc) 50%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--pc) 11%, transparent);
    /* Large text: --pc keeps 3:1 in both themes. */
    color: var(--pc);
    font-size: 0.84em;
    line-height: 1;
    text-decoration: none;
    vertical-align: 0.06em;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  .pill i {
    width: 0.3em;
    height: 0.3em;
    border-radius: 50%;
    background: var(--pc);
    box-shadow: 0 0 0.4em var(--pc);
  }
  .pill:hover {
    background: color-mix(in srgb, var(--pc) 22%, transparent);
    border-color: var(--pc);
  }
  .sign {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: clamp(40px, 4.4vw, 64px) 0 0;
    font: 500 11px/1.4 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .sign svg {
    flex: none;
    width: 34px;
    height: 34px;
  }
  /* Each word lights up as it crosses the screen, in CSS alone. Without support, with reduced motion
     or with SIM paused, the paragraph reads whole from the start. Longhands: see global.css. */
  @supports (animation-timeline: view()) {
    .w {
      animation-name: reveal;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 70% cover 42%;
    }
    :global(:root[data-motion='off']) .w {
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w {
      animation: none !important;
    }
  }
</style>
