---
import { getMessages, type Lang } from '../../i18n';
import { localizedPath, navLabelKeys, routeKeys, type RouteKey } from '../../i18n/routes';
import Brand from './Brand.astro';
import LangSwitch from './LangSwitch.astro';
import MobileMenu from './MobileMenu.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  /** Current page, or null outside the navigation (404). */
  route: RouteKey | null;
}

const { lang, route } = Astro.props;
const t = getMessages(lang);
---

<header class="nav">
  <div class="nav__bg"></div>
  <div class="wrap nav__bar">
    <Brand lang={lang} class="nav__brand" />
    <nav class="nav__links" aria-label={t.ui.navLabel}>
      <ul class="links">
        {routeKeys.map((key) => (
          <li>
            <a
              class="link"
              href={localizedPath(key, lang)}
              aria-current={key === route ? 'page' : undefined}
            >
              {t.nav[navLabelKeys[key]]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <LangSwitch lang={lang} route={route} class="tools__lang" />
      <ThemeToggle lang={lang} />
      <button
        type="button"
        class="ico menubtn"
        aria-label={t.ui.menu}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-open
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 9h16M4 15h11"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
<MobileMenu lang={lang} route={route} />

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .nav__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Almost opaque instead of a backdrop blur: re-blurring what scrolls under the bar costs the GPU
       several passes on every frame. */
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    border-bottom: 1px solid var(--line);
  }
  @supports (animation-timeline: scroll()) {
    .nav__bg {
      opacity: 0;
      animation-name: fade;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 30px 220px;
    }
  }
  .nav__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--nav-height);
  }
  .nav__brand {
    margin-right: auto;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 10px;
    color: var(--fg-muted);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }
  .link:hover,
  .link[aria-current='page'] {
    color: var(--fg);
  }
  .link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 5px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--warm);
    box-shadow: 0 0 10px var(--warm);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 10px;
  }
  .menubtn {
    display: none;
  }
  @media (max-width: 980px) {
    /* The whole landmark goes, not just its list: an empty navigation would still be announced. */
    .nav__links,
    .nav .tools__lang {
      display: none;
    }
    .menubtn {
      display: inline-grid;
    }
  }
</style>
