---
import { now } from '../../content/now';
import { getMessages, type Lang } from '../../i18n';
import { formatShortDate } from '../../lib/dates';
import NowIcon from './NowIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
---

<section class="now" aria-labelledby="now-title">
  <div class="wrap now__in">
    <div class="now__head">
      <h2 id="now-title">{t.now.title}</h2>
      <p class="label">
        {t.now.updated} <time datetime={now.updatedAt}>{formatShortDate(now.updatedAt, lang)}</time>
      </p>
    </div>
    <ul class="now__list">
      {now.items.map((item, index) => (
        <li class:list={['now__item', `tone-${item.tone}`]}>
          <span class="now__icon" aria-hidden="true">
            <NowIcon icon={item.icon} />
            <span>0{index + 1}</span>
          </span>
          <p class="now__text">{item.text[lang]}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .now {
    position: relative;
    z-index: 3;
    border-block: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-alt) 70%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .now__in {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 28px;
    padding-block: 34px;
  }
  .now__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 2px;
  }
  .now__head h2 {
    margin: 0;
    font: 600 15px/1.2 var(--sans);
    letter-spacing: 0.01em;
    color: var(--fg);
  }
  .now__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .now__item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 2px 22px;
    border-left: 1px solid var(--line);
  }
  .now__icon {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-subtle);
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.12em;
  }
  .tone-kimen :global(svg) {
    color: var(--kimen);
  }
  .tone-jezero :global(svg) {
    color: var(--jezero);
  }
  .tone-orbit :global(svg) {
    color: var(--orbit);
  }
  .tone-muted :global(svg) {
    color: var(--fg-muted);
  }
  .now__text {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.45;
    color: var(--fg);
    text-wrap: pretty;
  }
  @media (max-width: 1180px) {
    .now__in {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .now__head {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }
  @media (max-width: 760px) {
    .now__list {
      grid-template-columns: 1fr;
    }
    .now__item {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
      padding: 16px 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .now__icon span {
      display: none;
    }
  }
</style>
