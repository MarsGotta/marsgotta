---
import type { NowIcon } from '../../content/now';

interface Props {
  icon: NowIcon;
}

const { icon } = Astro.props;
---

{icon === 'planet' && (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="5" />
    <path d="M5 15.2c-2 1.4-2.9 2.8-2.3 3.6 1.1 1.4 6.1-.5 11-4.1s8.2-7.8 7.1-9.2c-.6-.8-2.2-.6-4.3.5" />
  </svg>
)}
{icon === 'satellite' && (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="m9.4 7.6 7 7-2.8 2.8-7-7z" />
    <path d="m8 9-3-3M16 15l3 3" />
    <path d="m2.4 6.6 3.2-3.2 2.4 2.4-3.2 3.2zM16 18.4l3.2-3.2 2.4 2.4-3.2 3.2z" />
    <path d="M14.5 4.5a5 5 0 0 1 5 5M14.5 1.8a7.7 7.7 0 0 1 7.7 7.7" />
  </svg>
)}
{icon === 'puzzle' && (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
  >
    <path d="M5 5h4.2a2.3 2.3 0 1 1 4.6 0H18v4.2a2.3 2.3 0 1 1 0 4.6V19h-4.2a2.3 2.3 0 1 0-4.6 0H5v-5.2a2.3 2.3 0 1 0 0-4.6Z" />
  </svg>
)}
{icon === 'cap' && (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M2.5 9 12 4.5 21.5 9 12 13.5z" />
    <path d="M6.5 11.2v4c0 1.6 2.5 2.9 5.5 2.9s5.5-1.3 5.5-2.9v-4" />
    <path d="M21.5 9v5.2" />
  </svg>
)}

<style>
  svg {
    width: 22px;
    height: 22px;
    flex: none;
  }
</style>
