---
import { getMessages, otherLang, type Lang } from '../../i18n';
import { localizedPath } from '../../i18n/routes';
import PageHeader from './PageHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
const other = otherLang(lang);
---

<PageHeader kicker="404" title={t.notFound.title} accent={t.notFound.accent} lead={t.notFound.lead}>
  <div class="actions">
    <a class="btn btn--primary" href={localizedPath('home', lang)}>
      {t.nav.inicio}
    </a>
    <a class="btn btn--ghost" href={localizedPath('home', other)} lang={other}>
      {getMessages(other).nav.inicio}
    </a>
  </div>
</PageHeader>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
</style>
