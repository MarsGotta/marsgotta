---
import { getMessages, type Lang } from '../../i18n';
import { localizedPath, toRouteKey } from '../../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
---

<ol class="index">
  {t.home.people.map((row) => (
    <li>
      <a class="row" href={localizedPath(toRouteKey(row.to), lang)}>
        <span class="k">{row.k}</span>
        <span class="t">{row.t}</span>
        <span class="d">{row.d}</span>
        <span class="y">{row.y}</span>
        <span class="go" aria-hidden="true">
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .index {
    margin: clamp(56px, 6vw, 96px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .row {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 120px minmax(0, 1.15fr) minmax(0, 1fr) 130px 44px;
    align-items: center;
    gap: 28px;
    min-height: 116px;
    padding: 24px 12px;
    border-bottom: 1px solid var(--line-strong);
    color: var(--fg);
    text-decoration: none;
  }
  /* overflow: hidden would clip the usual ring outside the row, so focus draws it inside. */
  .row:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }
  /* The background rises from below: transform only. */
  .row::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--card);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .row:hover::before,
  .row:focus-visible::before {
    transform: none;
  }
  .k {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm-text);
  }
  .t {
    font: 600 clamp(22px, 2.2vw, 32px) / 1.12 var(--display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .d {
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  .y {
    font: 500 11px/1.4 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    text-align: right;
  }
  .go {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 0.3s,
      border-color 0.3s,
      color 0.3s;
  }
  .go svg {
    width: 16px;
    height: 16px;
  }
  .row:hover .go,
  .row:focus-visible .go {
    transform: rotate(-45deg);
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  @media (max-width: 980px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 44px;
      gap: 12px 20px;
      padding: 26px 4px;
    }
    .k,
    .t,
    .d,
    .y {
      grid-column: 1;
    }
    .go {
      grid-column: 2;
      grid-row: 1 / span 4;
    }
    .y {
      text-align: left;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row::before,
    .go {
      transition: none;
    }
  }
</style>
