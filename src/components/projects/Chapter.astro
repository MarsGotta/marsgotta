---
import type { Lang } from '../../i18n';
import NewTabHint from '../layout/NewTabHint.astro';

interface Props {
  lang: Lang;
  /** The anchor the page index links to. */
  id: string;
  /** The colour class, such as p-kimen. */
  tone: string;
  /** The chapter number; the method has none. */
  index?: string;
  role: string;
  name: string;
  /** The name written out, under a short one. */
  full?: string;
  sub: string;
  chips?: string[];
  links: { label: string; href: string }[];
  desc: string;
  bullets: string[];
  note?: { lead?: string; text: string };
  stack?: string;
}

const {
  lang,
  id,
  tone,
  index,
  role,
  name,
  full,
  sub,
  chips = [],
  links,
  desc,
  bullets,
  note,
  stack,
} = Astro.props;
const titleId = `project-${id}`;
---

<article class:list={['chap', tone]} id={id} aria-labelledby={titleId}>
  <div class="grid">
    <div>
      <p class="idx">
        {index && <span>{index}</span>}
        <i></i>
        <span>{role}</span>
      </p>
      <h2 class="name" id={titleId}>
        {name}
        {/* The space keeps «GDD Gate-Driven Development» two words for screen readers and search. */}
        {full && (
          <>
            {' '}
            <span class="full">{full}</span>
          </>
        )}
      </h2>
      <h3 class="sub">{sub}</h3>
      <div class="meta">
        {chips.map((chip) => (
          <span class="chip">{chip}</span>
        ))}
        {links.map((link) => (
          <a class="ext" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <span aria-hidden="true">↗</span>
            <NewTabHint lang={lang} />
          </a>
        ))}
      </div>
      <p class="desc">{desc}</p>
      <ul class="bullets">
        {bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
      {note && (
        <p class="note">
          {note.lead && <em>{note.lead}</em>} {note.text}
        </p>
      )}
      {stack && (
        <p class="stack">
          <span class="label">Stack</span>
          {stack}
        </p>
      )}
    </div>
    <div class="aside">
      <slot />
    </div>
  </div>
</article>

<style>
  .chap {
    position: relative;
    padding-block: clamp(80px, 9vw, 140px);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 96px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(36px, 5.5vw, 96px);
    align-items: start;
  }
  .idx {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--pc-text);
  }
  .idx i {
    width: 46px;
    height: 1px;
    background: currentColor;
  }
  .idx span {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .name {
    margin: 22px 0 0;
    font: 700 clamp(64px, 9.4vw, 150px) / 0.9 var(--display);
    letter-spacing: -0.05em;
  }
  .full {
    display: block;
    margin-top: 14px;
    font: 500 12px/1.2 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .sub {
    margin: 14px 0 0;
    font: 600 clamp(20px, 2vw, 28px) / 1.2 var(--display);
    letter-spacing: -0.02em;
    color: var(--pc-text);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 26px;
    color: var(--pc-text);
  }
  .meta .ext {
    color: var(--fg-muted);
  }
  .desc {
    margin: 28px 0 0;
    font-size: clamp(18px, 1.4vw, 20px);
    line-height: 1.6;
    color: var(--fg);
  }
  .bullets {
    display: grid;
    gap: 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    color: var(--fg-muted);
    font-size: 16.5px;
    line-height: 1.55;
  }
  .bullets li::before {
    content: '';
    width: 7px;
    height: 7px;
    margin-top: 9px;
    border-radius: 50%;
    border: 1.4px solid var(--pc);
  }
  .note {
    margin: 26px 0 0;
    padding: 18px 20px;
    border: 1px dashed var(--line-strong);
    border-radius: 16px;
    color: var(--fg-muted);
    font-size: 15.5px;
    line-height: 1.6;
  }
  .note em {
    font-style: italic;
    color: var(--fg);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin: 28px 0 0;
    color: var(--fg-muted);
    font-size: 15px;
  }
  .aside {
    position: sticky;
    top: 110px;
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .aside {
      position: static;
    }
  }
</style>
