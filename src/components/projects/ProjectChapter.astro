---
import type { ProjectKey } from '../../content/projects';
import { getMessages, type Lang } from '../../i18n';
import DemoStage from '../system/DemoStage.astro';
import JezeroDemo from '../system/JezeroDemo.astro';
import KimenDemo from '../system/KimenDemo.astro';
import OrbitDemo from '../system/OrbitDemo.astro';
import Chapter from './Chapter.astro';

interface Props {
  lang: Lang;
  project: ProjectKey;
  index: number;
}

const { lang, project, index } = Astro.props;
const t = getMessages(lang);
const item = t.pj.items[project];
const summary = t.sys.items[project];
const Demo = { kimen: KimenDemo, jezero: JezeroDemo, orbit: OrbitDemo }[project];
---

<Chapter
  lang={lang}
  id={project}
  tone={`p-${project}`}
  index={`0${index + 1}`}
  role={item.role}
  name={summary.name}
  sub={item.sub}
  chips={summary.chips}
  links={item.links}
  desc={item.desc}
  bullets={item.bullets}
  note={'note' in item ? { lead: item.noteK, text: item.note } : undefined}
  stack={item.stack}
>
  <DemoStage active={project} large>
    <Demo lang={lang} />
  </DemoStage>
</Chapter>
