---
import type { ProjectKey } from '../../content/projects';
import { getMessages, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  project: ProjectKey;
  /** Describes the animation for assistive tech: the demo itself is decorative. */
  alt: string;
  title: string;
  meta: string;
  hidden?: boolean;
}

const { lang, project, alt, title, meta, hidden = false } = Astro.props;
const t = getMessages(lang);
---

<div
  class:list={['demo', `p-${project}`]}
  role="img"
  aria-label={alt}
  data-project={project}
  hidden={hidden}
>
  {/* The label describes the animation: what is drawn inside is not read on its own. */}
  <div class="bar" aria-hidden="true">
    <i></i>
    <span>{title}</span>
    <span class="meta">{meta}</span>
    {/* The demos show made-up data: the label keeps anyone from reading it as real. */}
    <span class="chip">{t.demo.example}</span>
  </div>
  <div class="body" aria-hidden="true">
    <slot />
  </div>
</div>

<style>
  .demo {
    position: absolute;
    inset: 0;
  }
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pc);
    box-shadow: 0 0 8px var(--pc);
  }
  .bar span {
    white-space: nowrap;
  }
  .bar .meta {
    margin-left: auto;
  }
  .bar .chip {
    height: 20px;
    padding: 0 8px;
    font-size: 9.5px;
    color: var(--pc-text);
  }
  /* On a phone the bar only fits the title and the label: the meta is decoration. */
  @media (max-width: 480px) {
    .bar .meta {
      display: none;
    }
    .bar .chip {
      margin-left: auto;
    }
  }
  .body {
    position: absolute;
    left: 0;
    right: 0;
    top: 34px;
    bottom: 0;
  }
</style>
