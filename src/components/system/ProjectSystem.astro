---
import { now } from '../../content/now';
import { projectKeys } from '../../content/projects';
import { getMessages, type Lang } from '../../i18n';
import { localizedPath } from '../../i18n/routes';
import { formatShortDate } from '../../lib/dates';
import DemoStage from './DemoStage.astro';
import JezeroDemo from './JezeroDemo.astro';
import KimenDemo from './KimenDemo.astro';
import Orrery from './Orrery.astro';
import OrbitDemo from './OrbitDemo.astro';
import ProjectTabs from './ProjectTabs.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang);
const method = t.pj.method;
const active = 'kimen';
---

<section class="sec" id="sistema" aria-labelledby="system-title" data-project-system>
  <div class="wrap">
    <p class="label rule kick">
      <span class="num">(01)</span>
      {t.sys.kicker}
    </p>
    <div class="head">
      <div class="title">
        <h2 class="h2" id="system-title">
          {t.sys.title}
        </h2>
        <p class="sub">{t.sys.sub}</p>
      </div>
      <div class="idea">
        <p class="label">{method.role}</p>
        <a class="arrow idea__name" href={localizedPath('projects', lang, 'gdd')}>
          {method.full}
          <span aria-hidden="true">→</span>
        </a>
        <p class="idea__motto">{method.sub}</p>
      </div>
    </div>
    <div class="grid">
      <Orrery lang={lang} active={active} />
      <div class="panel">
        <p class="status">
          {t.home.sysLead}{' '}
          <time datetime={now.updatedAt}>{formatShortDate(now.updatedAt, lang)}</time>.
        </p>
        <ProjectTabs lang={lang} active={active} controls="project-stage" />
        <DemoStage id="project-stage" active={active}>
          <KimenDemo lang={lang} />
          <JezeroDemo lang={lang} hidden />
          <OrbitDemo lang={lang} hidden />
        </DemoStage>
        <div class="panel__foot">
          {projectKeys.map((key) => (
            <a
              class="arrow"
              href={localizedPath('projects', lang, key)}
              data-project={key}
              hidden={key !== active}
            >
              {t.sys.items[key].cta}
              <span aria-hidden="true">→</span>
            </a>
          ))}
          {projectKeys.map((key) => (
            <span class="label" data-project={key} hidden={key !== active}>
              {t.sys.items[key].stack}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initProjectSystems } from '../../scripts/project-tabs';

  initProjectSystems();
</script>

<style>
  /* The heading and its subtitle share the header's left column; the idea that joins the three
     pieces, GDD, takes the right one. */
  .title {
    grid-column: 1 / 8;
  }
  .sub {
    margin: 18px 0 0;
    font: 600 clamp(20px, 2vw, 28px) / 1.2 var(--display);
    letter-spacing: -0.02em;
    color: var(--fg-muted);
  }
  .idea {
    grid-column: 8 / 13;
    display: grid;
    justify-items: start;
    gap: 14px;
    padding: 0 0 6px 24px;
    border-left: 1px solid var(--line-strong);
  }
  .idea__name {
    font: 600 clamp(22px, 2vw, 30px) / 1.15 var(--display);
    letter-spacing: -0.02em;
  }
  .idea__motto {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  .status {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 1fr);
    gap: clamp(36px, 5vw, 88px);
    align-items: center;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .panel__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  @media (max-width: 980px) {
    .title,
    .idea {
      grid-column: 1 / -1;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
