---
import { now } from '../../content/now';
import { projectKeys, type ProjectKey } from '../../content/projects';
import { getMessages, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  active: ProjectKey;
  /** The stage the tabs switch. */
  controls: string;
}

const { lang, active, controls } = Astro.props;
const t = getMessages(lang);
---

<div class="tabs">
  {projectKeys.map((key, index) => {
    const project = t.sys.items[key];
    return (
      <button
        type="button"
        class:list={['tab', `p-${key}`]}
        aria-pressed={key === active ? 'true' : 'false'}
        aria-controls={controls}
        data-project-tab={key}
      >
        <span class="tab__idx">0{index + 1}</span>
        <span>
          <span class="tab__name">
            <i />
            {project.name}
          </span>
          <span class="tab__line">{project.line}</span>
          <span class="tab__now">
            <b>{t.home.nowK}</b>
            {now.items[key][lang]}
          </span>
        </span>
        <span class="tab__chips">
          {project.chips.map((chip) => (
            <span class="chip">{chip}</span>
          ))}
        </span>
      </button>
    );
  })}
</div>

<style>
  .tabs {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .tab {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 88px;
    padding: 16px 6px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--fg);
    text-align: left;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .tab:hover {
    background: var(--card);
  }
  .tab__idx {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.14em;
    color: var(--fg-subtle);
  }
  .tab__name {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 600 26px/1.05 var(--display);
    letter-spacing: -0.025em;
    transition: color 0.3s;
  }
  .tab__name i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.4px solid var(--fg-subtle);
    transition: all 0.3s;
  }
  .tab__line {
    display: block;
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--fg-muted);
  }
  .tab__now {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--fg-subtle);
    transition: color 0.3s;
  }
  .tab__now b {
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .tab[aria-pressed='true'] .tab__now {
    color: var(--fg-muted);
  }
  .tab[aria-pressed='true'] .tab__now b {
    color: var(--pc-text);
  }
  .tab__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    color: var(--fg-subtle);
  }
  .tab[aria-pressed='true'] .tab__name {
    color: var(--pc);
  }
  .tab[aria-pressed='true'] .tab__chips {
    color: var(--pc-text);
  }
  .tab[aria-pressed='true'] .tab__name i {
    background: var(--pc);
    border-color: var(--pc);
    box-shadow: 0 0 12px var(--pc);
  }
  @media (max-width: 560px) {
    .tab {
      grid-template-columns: 34px minmax(0, 1fr);
    }
    .tab__chips {
      display: none;
    }
  }
</style>
