---
import { getMessages, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const t = getMessages(Astro.props.lang).talks;
const startYear = (period: string) => period.match(/\d{4}/)?.[0];
---

<section class="sec sec--tight" aria-label={t.kicker}>
  <div class="wrap">
    <ol class="talks">
      {t.items.map((talk) => (
        <li class="talk">
          <time datetime={startYear(talk.year)}>{talk.year}</time>
          <span class="chip">{talk.type}</span>
          <h2>{talk.title}</h2>
          <p>{talk.where}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .talks {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .talk {
    position: relative;
    display: grid;
    grid-template-columns: 170px 130px minmax(0, 1fr) minmax(0, 280px);
    align-items: baseline;
    gap: 24px;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.35s var(--ease-soft);
  }
  .talk:hover {
    padding-left: 12px;
  }
  .talk::before {
    content: '';
    position: absolute;
    left: -26px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    border: 1.4px solid var(--warm);
    opacity: 0;
    transition:
      opacity 0.3s,
      background-color 0.3s;
  }
  .talk:hover::before {
    opacity: 1;
    background: var(--warm);
  }
  time {
    font: 500 12px/1.4 var(--mono);
    letter-spacing: 0.1em;
    color: var(--warm-text);
  }
  .chip {
    justify-self: start;
    color: var(--fg-muted);
  }
  h2 {
    margin: 0;
    font: 600 clamp(20px, 2.1vw, 28px) / 1.2 var(--display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 15.5px;
    line-height: 1.45;
  }
  @media (max-width: 980px) {
    .talk {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }
    .talk:hover {
      padding-left: 0;
    }
  }
</style>
