---
import '@fontsource/sora/latin-600.css';
import '@fontsource/sora/latin-700.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import headlineFont from '@fontsource/sora/files/sora-latin-700-normal.woff2?url';
import Footer from '../components/layout/Footer.astro';
import SeoHead from '../components/layout/SeoHead.astro';
import SvgDefs from '../components/layout/SvgDefs.astro';
import Nav from '../components/nav/Nav.astro';
import { getMessages, type Lang } from '../i18n';
import { pageMeta } from '../i18n/meta';
import type { RouteKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Null for the 404 page, which sits outside the navigation. */
  route: RouteKey | null;
}

const { lang, route } = Astro.props;
const t = getMessages(lang);
const { title, description } = route
  ? pageMeta(route, lang)
  : { title: '404 · Marcela Gotta', description: pageMeta('home', lang).description };
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SeoHead lang={lang} route={route} title={title} description={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={headlineFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Applies the theme and the SIM pause before the first paint, so the page never flashes. The
      // theme is the visitor's choice if there is one, and otherwise the system's.
      let saved = null;
      try {
        saved = localStorage.getItem('theme');
        if (localStorage.getItem('motion') === 'off') {
          document.documentElement.dataset.motion = 'off';
        }
      } catch {
        // Storage blocked: follow the system.
      }
      const light = saved ? saved === 'light' : matchMedia('(prefers-color-scheme: light)').matches;
      if (light) document.documentElement.dataset.theme = 'light';
    </script>
  </head>
  <body>
    <SvgDefs />
    <div class="site">
      <a class="skip" href="#main">
        {t.ui.skip}
      </a>
      <Nav lang={lang} route={route} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
