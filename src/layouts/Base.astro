---
import '@fontsource/sora/latin-600.css';
import '@fontsource/sora/latin-700.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import headlineFont from '@fontsource/sora/files/sora-latin-700-normal.woff2?url';
import Footer from '../components/layout/Footer.astro';
import SvgDefs from '../components/layout/SvgDefs.astro';
import Nav from '../components/nav/Nav.astro';
import { getMessages, type Lang } from '../i18n';
import { pageMeta } from '../i18n/meta';
import type { RouteKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  route: RouteKey;
}

const { lang, route } = Astro.props;
const t = getMessages(lang);
const { title, description } = pageMeta(route, lang);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={headlineFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Applies the saved theme before the first paint, so the page never flashes the wrong one.
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {
        // Storage blocked: keep the dark default.
      }
    </script>
  </head>
  <body>
    <SvgDefs />
    <div class="site">
      <a class="skip" href="#main">
        {t.ui.skip}
      </a>
      <Nav lang={lang} route={route} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
