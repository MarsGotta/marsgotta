---
import ContactSection from '../components/contact/ContactSection.astro';
import PageHeader from '../components/page/PageHeader.astro';
import { getMessages, type Lang } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang).contact;
---

<Base lang={lang} route="contact">
  <PageHeader kicker={t.kicker} title={t.h1} lead={t.lead} gradient />
  <ContactSection lang={lang} />
</Base>
