---
import Closing from '../components/close/Closing.astro';
import Hero from '../components/hero/Hero.astro';
import NowBand from '../components/now/NowBand.astro';
import ProjectSystem from '../components/system/ProjectSystem.astro';
import TransferOrbit from '../components/trajectory/TransferOrbit.astro';
import type { Lang } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base lang={lang} route="home">
  <Hero lang={lang} />
  <NowBand lang={lang} />
  <ProjectSystem lang={lang} />
  <TransferOrbit lang={lang} />
  <Closing lang={lang} />
</Base>
