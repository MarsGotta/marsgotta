---
import Closing from '../components/close/Closing.astro';
import Hero from '../components/hero/Hero.astro';
import People from '../components/people/People.astro';
import ProjectSystem from '../components/system/ProjectSystem.astro';
import type { Lang } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{/* The home as a story in three numbered acts: what I build, with whom, with you. */}
<Base lang={lang} route="home">
  <Hero lang={lang} />
  <ProjectSystem lang={lang} />
  <People lang={lang} />
  <Closing lang={lang} />
</Base>
