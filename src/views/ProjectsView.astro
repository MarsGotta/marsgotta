---
import PageHeader from '../components/page/PageHeader.astro';
import MethodChapter from '../components/projects/MethodChapter.astro';
import OnmarsBand from '../components/projects/OnmarsBand.astro';
import ProjectChapter from '../components/projects/ProjectChapter.astro';
import ProjectNav from '../components/projects/ProjectNav.astro';
import { projectKeys } from '../content/projects';
import { getMessages, type Lang } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang).pj;
---

<Base lang={lang} route="projects">
  <PageHeader kicker={t.kicker} title={t.h1a} accent={t.h1b} lead={t.lead}>
    <ProjectNav lang={lang} />
  </PageHeader>
  <div class="wrap">
    {projectKeys.map((project, index) => (
      <ProjectChapter lang={lang} project={project} index={index} />
    ))}
    <MethodChapter lang={lang} />
    <OnmarsBand lang={lang} />
  </div>
</Base>
