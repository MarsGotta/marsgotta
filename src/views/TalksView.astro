---
import PageHeader from '../components/page/PageHeader.astro';
import TalkList from '../components/talks/TalkList.astro';
import { getMessages, type Lang } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getMessages(lang).talks;
---

<Base lang={lang} route="talks">
  <PageHeader kicker={t.kicker} title={t.h1a} accent={t.h1b} caption={t.caption} />
  <TalkList lang={lang} />
</Base>
