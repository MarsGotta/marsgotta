{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marcelagotta",
  "main": "workers/site/index.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The pages run code to pick the visitor's language (workers/site/language.ts), and /api/* is
    // the contact endpoint. Scripts, styles, fonts and images are served without it.
    "run_worker_first": [
      "/api/*",
      "/",
      "/sobre-mi",
      "/proyectos",
      "/charlas",
      "/contacto",
      "/en",
      "/en/*",
    ],
  },
  // The binding can only write to Marcela from web@, so not even a bug can email anyone else.
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "me@marcelagotta.com",
      "allowed_sender_addresses": ["web@mail.marcelagotta.com"],
    },
  ],
  // Five messages a minute per visitor IP: plenty for a person, little for a script.
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // The canonical host. www.marcelagotta.com, marsgotta.com and www.marsgotta.com redirect here
  // from their own Worker (workers/redirect).
  "routes": [{ "pattern": "marcelagotta.com", "custom_domain": true }],
  // wrangler turns workers.dev off when routes exist, so it is turned back on here. Version URLs
  // preview a build on workers.dev without touching production (npm run deploy:preview).
  "workers_dev": true,
  "preview_urls": true,
}
